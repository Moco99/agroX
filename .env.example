# Copia este archivo como .env y llena las llaves que tengas. .env NO se sube a git.
EARTHDATA_TOKEN=
NASS_API_KEY=
AMS_API_KEY=
OPENET_API_KEY=
CDS_API_KEY=
LANDFIRE_EMAIL=

# ── Remote raw data on S3 (read-only on-demand access; see docs/04-data/storage-s3.md) ──
# Name of the bucket holding the raw/ mirror (never commit the real value)
AGROX_S3_BUCKET=
# Named AWS profile with read-only access (default credential chain is used when empty)
AWS_PROFILE=
AWS_REGION=us-east-1
# auto = S3 when configured and reachable, else local data/raw | s3 | local
AGROX_DATA_SOURCE=auto

# Bounded local cache for remote byte ranges
AGROX_CACHE_MAX_MB=512

# Data mode: real (derived/ pilot data, default) | synthetic (offline demo data) | live (real + any parcel pt_<lat>_<lon>, needs network)
AGROX_DATA_MODE=real
# Directory for the live-source cache (default: a folder under the OS temp/user cache dir)
AGROX_CACHE_DIR=
